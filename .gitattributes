# 1. Global Default: Treat everything as text and force LF (Linux) line endings
* text=auto eol=lf

# 2. Binary Overrides: Things that should NEVER be touched/converted
*.bin binary
*.pt binary
*.pth binary
*.ckpt binary
*.h5 binary
*.safetensors binary
*.onnx binary
*.npy binary
*.npz binary
*.pkl binary
*.joblib binary
*.model binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.ipynb binary
*.exe binary
*.dll binary
*.so binary
*.pyc binary

# 3. Specific Text Force (Optional, usually covered by * text=auto)
*.sh text eol=lf
*.py text eol=lf
*.rs text eol=lf
